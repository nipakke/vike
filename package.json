{
  "name": "@nipakke/vike",
  "private": true,
  "scripts": {
    "dev:ui": "turbo dev --filter=@playgrounds/nuxt-ui-minimal --filter=@nipakke/vike-nuxt-ui",
    "build": "turbo build",
    "build:ui": "turbo build --filter=@nipakke/vike-nuxt-ui",
    "clean": "turbo clean",
    "lint": "turbo lint",
    "check": "turbo check",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "changeset": "changeset",
    "version": "changeset version && vp install",
    "release": "turbo build && changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nipakke/vike.git"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "turbo": "^2.6.0",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.33.2"
}