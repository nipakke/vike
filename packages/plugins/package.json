{
  "name": "@nipakke/vike-plugins",
  "private": true,
  "description": "Auto-discovered per-request plugin system for Vike",
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nipakke/vike.git",
    "directory": "packages/plugins"
  },
  "bugs": {
    "url": "https://github.com/nipakke/vike/issues"
  },
  "homepage": "https://github.com/nipakke/vike/tree/main/packages/plugins#readme",
  "keywords": [
    "vike",
    "plugins",
    "ssr",
    "vite"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./vike": {
      "types": "./dist/vike.d.ts",
      "default": "./dist/vike.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./runner": "./dist/runner.js",
    "./config": "./dist/+config.js"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "knitwork": "^1.3.0",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/browser-preview": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.0",
    "playwright": "^1.59.1",
    "vike": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "vike": ">=0.4.249"
  }
}
